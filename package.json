{
  "name": "glance-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "start:local": "EXPO_PUBLIC_API_ENV=local expo start --lan -c",
    "start:staging": "EXPO_PUBLIC_API_ENV=staging expo start --lan -c",
    "start:production": "EXPO_PUBLIC_API_ENV=production expo start --lan -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "version:get": "node scripts/version-tools.js get",
    "version:get:local": "node scripts/version-tools.js get --env=local",
    "version:get:staging": "node scripts/version-tools.js get --env=staging",
    "version:get:production": "node scripts/version-tools.js get --env=production",
    "version:set": "node scripts/version-tools.js set",
    "version:bump": "node scripts/version-tools.js bump",
    "version:bump:patch": "node scripts/version-tools.js bump patch",
    "version:bump:minor": "node scripts/version-tools.js bump minor",
    "version:bump:major": "node scripts/version-tools.js bump major",
    "version:bump:local": "node scripts/version-tools.js bump patch --env=local",
    "version:bump:staging": "node scripts/version-tools.js bump patch --env=staging",
    "version:bump:production": "node scripts/version-tools.js bump patch --env=production",
    "version:prepare": "node scripts/version-tools.js prepare",
    "build": "node scripts/build.js production",
    "build:local": "node scripts/build.js local",
    "build:local:no-bump": "SKIP_VERSION_BUMP=1 node scripts/build.js local",
    "build:staging": "node scripts/build.js staging",
    "build:staging:no-bump": "SKIP_VERSION_BUMP=1 node scripts/build.js staging",
    "build:production": "node scripts/build.js production",
    "build:production:no-bump": "SKIP_VERSION_BUMP=1 node scripts/build.js production",
    "build:android:preview": "node scripts/build.js staging --platform=android",
    "build:ios:preview": "node scripts/build.js staging --platform=ios",
    "build:android:production": "node scripts/build.js production --platform=android",
    "build:android:production-apk": "node scripts/build.js production --platform=android --apk",
    "build:ios:production": "node scripts/build.js production --platform=ios",
    "test:version-tools": "node tests/versionTools.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\" --config .prettierrc --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\" --config .prettierrc --ignore-path .prettierignore"
  },
  "dependencies": {
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.4.7",
    "@react-navigation/native": "7.1.34",
    "@react-navigation/native-stack": "7.3.16",
    "axios": "^1.13.2",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-local-authentication": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "@react-navigation/elements": "2.6.4"
    }
  }
}
