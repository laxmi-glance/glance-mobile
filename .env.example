# Environment notes
#
# Prefer pnpm scripts instead of editing this file:
#   pnpm start:local
#   pnpm start:staging
#   pnpm start:production
#
# Optional full-URL override:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api pnpm start:local
#
# Production login requires recaptcha_token unless DISABLE_RECAPTCHA=true
# on the backend.

EXPO_PUBLIC_API_ENV=staging
DEBUG=true
API_TIMEOUT=30000
