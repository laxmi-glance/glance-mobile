# Environment Configuration

# API Configuration
# For local development, use your computer's IP address for physical devices
# For iOS Simulator: use localhost or your IP
# For Android Emulator: use 10.0.2.2

# Development
API_BASE_URL=http://localhost:8000/api

# Staging
# API_BASE_URL=https://staging.glancewise.app/api

# Production
# API_BASE_URL=https://app.glancewise.app/api

# Optional: Enable debug mode
DEBUG=true

# Optional: API timeout (milliseconds)
API_TIMEOUT=30000
