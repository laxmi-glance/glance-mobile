# Environment notes
#
# Prefer pnpm scripts instead of editing this file:
#   pnpm start:local
#   pnpm start:staging
#   pnpm start:production
#
# Local mode rewrites localhost to Expo's LAN IP automatically (phone + local
# Django/web). Optional full-URL override if auto-detect picks the wrong NIC:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api pnpm start:local
#   EXPO_PUBLIC_FRONTEND_URL=http://192.168.1.10:3000 pnpm start:local
#
# Captcha: this app has no captcha of its own — login runs in the web view against
# the Glance web app, which reads the backend's DISABLE_RECAPTCHA flag from
# GET /api/public-config/. Toggling DISABLE_RECAPTCHA in the backend env for an
# environment therefore covers this app too; nothing to configure here.

EXPO_PUBLIC_API_ENV=staging
DEBUG=true
API_TIMEOUT=30000
